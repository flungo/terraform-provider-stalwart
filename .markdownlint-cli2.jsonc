{
  // Standard flungo Markdown-lint defaults. See flungo/github-workflows
  // docs/reference/markdown-validation.md for the rationale.
  "config": {
    // Line length is not capped: we adopt semantic line breaks (one sentence
    // per source line) instead of a character ceiling. See CLAUDE.md.
    "MD013": false,
    // Duplicate headings are allowed only under different parents, so ADRs can
    // reuse subsection names (Context / Decision / Consequences).
    "MD024": { "siblings_only": true },

    // MD060 table-column-style: pin "compact" rather than leaving MD060 at its
    // ambiguous default ("consistent" infers per table, and picks "aligned"
    // where no row disambiguates). Under "aligned" a cell's width is shared
    // state — every cell is padded to its column's widest — so one long value
    // reflows every row and a diff stops being the size of the change.
    "MD060": { "style": "compact" }
  },
  // The docs under docs/resources/, docs/data-sources/, and docs/index.md are
  // generated by tfplugindocs from schema descriptions, examples/, and
  // templates/. tfplugindocs is the sole authority on their formatting, so
  // exclude them here rather than have markdownlint and regeneration pull in
  // two different directions. lychee still link-checks them via
  // markdown-links.yml, and the docs-in-sync check keeps them regenerated.
  "ignores": [
    "docs/index.md",
    "docs/resources/**",
    "docs/data-sources/**"
  ]
}
